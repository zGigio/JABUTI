Terminals unused in grammar

    "caractere invalido"


Grammar

    0 $accept: programa $end

    1 $@1: %empty

    2 programa: "'programa'" nome_programa '{' $@1 lista_comandos '}'

    3 nome_programa: %empty
    4              | "identificador"

    5 lista_comandos: %empty
    6               | lista_comandos comando

    7 comando: declaracao
    8        | atribuicao
    9        | entrada
   10        | saida
   11        | condicional
   12        | repeticao
   13        | para
   14        | bloco
   15        | error ';'
   16        | error

   17 $@2: %empty

   18 declaracao: tipo $@2 lista_declaradores ';'
   19           | "'constante'" tipo "identificador" '=' expressao ';'

   20 tipo: "'inteiro'"
   21     | "'real'"
   22     | "'texto'"
   23     | "'booleano'"

   24 lista_declaradores: declarador
   25                   | lista_declaradores ',' declarador

   26 declarador: "identificador"
   27           | "identificador" '=' expressao

   28 atribuicao: "identificador" '=' expressao ';'

   29 entrada: "'leia'" '(' lista_leitura ')' ';'

   30 lista_leitura: "identificador"
   31              | lista_leitura ',' "identificador"

   32 saida: "'escreva'" '(' lista_argumentos ')' ';'
   33      | "'escreval'" '(' lista_argumentos ')' ';'
   34      | "'escreval'" '(' ')' ';'

   35 lista_argumentos: expressao
   36                 | lista_argumentos ',' expressao

   37 $@3: %empty

   38 condicional: "'se'" '(' expressao ')' $@3 bloco senao_opt

   39 senao_opt: %empty

   40 $@4: %empty

   41 senao_opt: "'senao'" $@4 senao_corpo

   42 senao_corpo: bloco
   43            | condicional

   44 $@5: %empty

   45 repeticao: "'enquanto'" '(' expressao ')' $@5 bloco

   46 $@6: %empty

   47 para: "'para'" '(' "identificador" "'de'" expressao "'ate'" expressao passo_opt ')' $@6 bloco

   48 passo_opt: %empty
   49          | "'passo'" "numero inteiro"
   50          | "'passo'" '-' "numero inteiro"

   51 $@7: %empty

   52 bloco: '{' $@7 lista_comandos '}'

   53 expressao: expressao "'ou'" conjuncao
   54          | conjuncao

   55 conjuncao: conjuncao "'e'" igualdade
   56          | igualdade

   57 igualdade: igualdade "'=='" relacional
   58          | igualdade "'!='" relacional
   59          | relacional

   60 relacional: relacional '<' soma
   61           | relacional '>' soma
   62           | relacional "'<='" soma
   63           | relacional "'>='" soma
   64           | soma

   65 soma: soma '+' termo
   66     | soma '-' termo
   67     | termo

   68 termo: termo '*' unario
   69      | termo '/' unario
   70      | termo '%' unario
   71      | unario

   72 unario: '-' unario
   73       | "'nao'" unario
   74       | primario

   75 primario: "numero inteiro"
   76         | "numero real"
   77         | "texto entre aspas"
   78         | "'verdadeiro'"
   79         | "'falso'"
   80         | "identificador"
   81         | '(' expressao ')'


